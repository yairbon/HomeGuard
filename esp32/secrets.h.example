// HomeGuard — per-board configuration template.
//
// SETUP: copy this file to `secrets.h` inside EACH of the three sketch
// folders, then fill in the real values:
//
//     esp32/ultrasonic_sensor/secrets.h
//     esp32/vibration_sensor/secrets.h
//     esp32/door_keypad_controller/secrets.h
//
// Three copies rather than one shared file because the Arduino IDE compiles
// one sketch folder at a time and only looks for headers inside that folder —
// a single `esp32/secrets.h` would not be found by any of them.
//
// `secrets.h` is gitignored. This `.example` is the only one that gets
// committed. Real WiFi credentials, the device key, and the keypad PIN used
// to live directly in the three .ino files and were therefore committed to
// this repository in plain text; keeping them here is what stops that from
// happening again.

#ifndef HOMEGUARD_SECRETS_H
#define HOMEGUARD_SECRETS_H

// --- WiFi ---
#define WIFI_SSID     "your-network-name"
#define WIFI_PASSWORD "your-network-password"

// --- Backend ---
// The IP of the machine running uvicorn (see python/README.md). Find it with
// `ipconfig` on Windows or `ip addr` on Linux. Not a hostname: the boards
// have no reliable mDNS/DNS resolution on a typical home network.
#define BACKEND_HOST "192.168.1.10"
#define BACKEND_PORT 8000

// --- Device key ---
// The shared secret every board presents to the backend on /esp32/* calls,
// and that the backend presents back to the door controller on /arm and
// /disarm. Without it, anything on the network could forge a sensor breach —
// or forge a "system disarmed" report.
//
// Get the value from the backend: set HOMEGUARD_DEVICE_KEY in its environment
// and use that, or let it generate one on first run and copy the key it logs
// at startup (it saves the generated key, so it stays the same across
// restarts).
#define DEVICE_KEY "paste-the-backend-device-key-here"

// --- Keypad (door_keypad_controller only) ---
// The PIN that disarms the system at the physical keypad. Ignored by the
// other two boards, which have no keypad.
#define KEYPAD_PIN "1234"

#endif  // HOMEGUARD_SECRETS_H
