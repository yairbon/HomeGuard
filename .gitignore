# OS/editor cruft not already covered by app/.gitignore or python/.gitignore
.DS_Store
Thumbs.db
Desktop.ini
*.swp

# WSL2 build scratch, if ever run from the repo root by mistake
/build/

# Per-board ESP32 config: real WiFi credentials, device key and keypad PIN.
# Only esp32/secrets.h.example is committed — see it for the setup steps.
esp32/*/secrets.h

# arduino-cli puts its build output (binaries, sdkconfig) next to the sketch
esp32/*/build/

# Backend runtime state (password hash, device key, faces, event log).
python/state.json
python/state.json.tmp

# Where alerts go and the credentials to send them (SMTP app password, CallMeBot
# key). Only python/alerts.example.json is committed.
python/alerts.local.json

# Review/verification virtualenv
python/.venv-review/
